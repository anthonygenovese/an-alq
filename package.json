{
  "name": "an-alq",
  "version": "0.1.0",
  "private": true,
  "description": "AN-ALQ workspace. Web shell, read-only MCP server, range trainer, and relay.",
  "type": "module",
  "license": "MIT",
  "author": "Anthony Genovese",
  "homepage": "https://an-alq.com",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/anthonygenovese/an-alq.git"
  },
  "bugs": {
    "url": "https://github.com/anthonygenovese/an-alq/issues"
  },
  "packageManager": "pnpm@12.21.0",
  "engines": {
    "node": ">=22.23.4"
  },
  "scripts": {
    "dev": "pnpm --filter @an-alq/web dev",
    "dev:mcp": "pnpm --filter @an-alq/mcp dev",
    "dev:sim": "pnpm --filter @an-alq/sim dev",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "pnpm -r --if-present typecheck",
    "test": "pnpm -r --if-present test",
    "build": "pnpm -r --if-present build",
    "audit": "pnpm audit --audit-level=high && pnpm audit signatures",
    "smoke": "pnpm --filter @an-alq/mcp smoke",
    "inspector": "pnpm --filter @an-alq/mcp inspector",
    "sbom": "cdxgen -t pnpm -o sbom.cdx.json --required-only --no-install-deps --no-recurse apps/mcp"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.4",
    "@commitlint/config-conventional": "^21.2.4",
    "@cyclonedx/cdxgen": "^12.7.1",
    "@eslint/js": "^9.39.5",
    "eslint": "^9.39.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^7.1.1",
    "prettier": "^3.10.1",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.46.2"
  }
}
