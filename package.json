{
  "name": "an-alq-mcp",
  "version": "0.1.0",
  "private": true,
  "description": "AN-ALQ MCP server. Illustrative electronic-warfare information over the Model Context Protocol.",
  "type": "module",
  "license": "MIT",
  "author": "Anthony Genovese",
  "homepage": "https://an-alq.com",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/anthonygenovese/an-alq.git"
  },
  "bugs": {
    "url": "https://github.com/anthonygenovese/an-alq/issues"
  },
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "start": "tsx src/http.ts",
    "start:stdio": "tsx src/stdio.ts",
    "dev": "tsx watch src/http.ts",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "smoke": "tsx scripts/list-tools.ts",
    "sim": "vite --config sim/vite.config.ts --host 127.0.0.1",
    "build:sim": "vite build --config sim/vite.config.ts",
    "typecheck:sim": "tsc -p sim/tsconfig.json --noEmit"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.2",
    "express": "^5.1.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@types/express": "^5.0.3",
    "@types/node": "^22.19.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "eslint": "^9.39.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tsx": "^4.20.5",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.46.2",
    "vite": "^8.3.8",
    "vitest": "^5.1.1"
  }
}
