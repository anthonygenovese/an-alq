{
  "name": "@an-alq/sim",
  "version": "0.1.0",
  "private": true,
  "description": "Tier 1 waterfall trainer and skill map. Synthetic spectrum. Nodes light on device.",
  "type": "module",
  "license": "MIT",
  "exports": {
    ".": {
      "types": "./src/range.tsx",
      "development": "./src/range.tsx",
      "default": "./dist/range.js"
    },
    "./range": {
      "types": "./src/range.tsx",
      "development": "./src/range.tsx",
      "default": "./dist/range.js"
    },
    "./map": {
      "types": "./src/map.tsx",
      "development": "./src/map.tsx",
      "default": "./dist/map.js"
    },
    "./styles.css": "./src/styles.css"
  },
  "engines": {
    "node": ">=22.23.4"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "pnpm --filter @an-alq/emitters build && tsc -p tsconfig.build.json && cp src/styles.css dist/styles.css && vite build",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@an-alq/emitters": "workspace:*",
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^22.19.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "fast-check": "^4.10.3",
    "typescript": "^6.0.3",
    "vite": "^8.3.8",
    "vitest": "^5.1.1"
  }
}
