{
  "name": "@an-alq/relay",
  "version": "0.1.0",
  "private": true,
  "description": "Read-only Nixle signal relay. Public posts are low sensitivity. Gmail is opt-in and high sensitivity. Never posts or sends mail.",
  "type": "module",
  "license": "MIT",
  "exports": {
    ".": {
      "types": "./src/runtime.ts",
      "development": "./src/runtime.ts",
      "default": "./dist/runtime.js"
    },
    "./chart": {
      "types": "./src/chart.ts",
      "development": "./src/chart.ts",
      "default": "./dist/chart.js"
    },
    "./types": {
      "types": "./src/types.ts",
      "development": "./src/types.ts",
      "default": "./dist/types.js"
    }
  },
  "engines": {
    "node": ">=22.23.4"
  },
  "scripts": {
    "test": "vitest run --config vitest.config.ts",
    "typecheck": "tsc --noEmit",
    "build": "tsc -p tsconfig.build.json"
  },
  "devDependencies": {
    "@types/node": "^22.19.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "typescript": "^5.8.3",
    "vitest": "^5.1.1"
  },
  "peerDependencies": {
    "react": "^19.3.1"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    }
  }
}
