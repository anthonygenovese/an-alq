{
  "name": "@an-alq/web",
  "version": "0.1.0",
  "private": true,
  "description": "AN-ALQ web shell. Range, skill map, and relay demo. Static-export compatible.",
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=22.23.4"
  },
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1 --port 3000",
    "build": "pnpm --filter @an-alq/emitters --filter @an-alq/relay --filter @an-alq/sim build && next build",
    "start": "next start --hostname 127.0.0.1 --port 3000",
    "typecheck": "mkdir -p .next/types && touch .next/types/routes.d.ts .next/types/root-params.d.ts && tsc --noEmit"
  },
  "dependencies": {
    "@an-alq/emitters": "workspace:*",
    "@an-alq/relay": "workspace:*",
    "@an-alq/sim": "workspace:*",
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "next": "16.4.6",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "typescript": "^6.0.3"
  }
}
