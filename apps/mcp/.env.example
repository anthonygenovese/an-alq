# Local bind. The process listens here only. Override HOST deliberately.
HOST=127.0.0.1
PORT=8787

# Comma-separated Host allowlist for the local server.
# Empty uses loopback names only. Ignored on Vercel, where preview hostnames move.
ALLOWED_HOSTS=

# Comma-separated exact browser origins. Empty denies every cross-origin call.
# `*` is ignored. Local mode also allows http://localhost and http://127.0.0.1
# with an optional port. On Vercel, list the real origins or leave this empty.
ALLOWED_ORIGINS=

# v0.1 has no API keys, database URL, or signing secret.
# Do not add one here. GitHub secret scanning and the gitleaks CI job assume that.
