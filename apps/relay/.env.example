# App-only bearer token for read-only recent search or the filtered stream.
# Do not put a user access token here. This process never posts.
# @logositis is a documentation example of a human subscriber. The app does not
# authenticate as that account.
X_BEARER_TOKEN=

# demo (default) or live
RELAY_MODE=demo

RELAY_HOST=127.0.0.1
RELAY_PORT=8790

# Recent-search spacing. 450 requests / 15 min app-only recent search; billing is per post returned.
RELAY_POLL_INTERVAL_MS=120000

# Dedup window. Default 30 minutes.
RELAY_TIME_WINDOW_MS=1800000

# Meters. Default 20 km.
RELAY_PROXIMITY_METERS=20000

# Transient dedup salt. Discarded on rotation. Default 15 minutes.
RELAY_SALT_ROTATION_MS=900000

# Decay is the retention policy. Defaults: 10 min half-life, 45 min hard stop.
RELAY_HALF_LIFE_MS=600000
RELAY_MIN_ACTIVITY=0.2
RELAY_INACTIVITY_TTL_MS=2700000

# 1 opens GET /2/tweets/search/stream. Rules must already exist in the
# developer console. This app does not create or delete rules.
RELAY_STREAM=0

X_API_BASE=https://api.x.com

# Bearer for GET /api/cron/relay and POST /api/ingest. Placeholder only.
CRON_SECRET=

# Upstash Redis REST. KV_REST_API_URL and KV_REST_API_TOKEN are accepted aliases.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
KV_REST_API_URL=
KV_REST_API_TOKEN=

# USD cap for one UTC month of post reads. Default 15 at 0.005 per post returned.
RELAY_X_BUDGET_USD=15
RELAY_X_UNIT_USD=0.005

# Set to 1 to allow live reads outside VERCEL_ENV=production. Leave empty on preview.
RELAY_ALLOW_PREVIEW=
